@page "/"
@using Werewolf.Models
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <MudGrid>
        @* 頂部資訊與操作區 *@
        <MudItem xs="12" Class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h4" Color="Color.Primary">
                <b>建立遊戲</b> (目前 @TotalPlayers 人)
            </MudText>
            <div>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenSettings" Class="mr-2">
                    遊戲規則
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="StartGame">
                    產生座位表
                </MudButton>
            </div>
        </MudItem>

        @* 版子推薦選擇 *@
        <MudItem xs="12" md="4">
            <MudSelect T="RoleSetup" Label="推薦版子 (快速套用)" Value="CurrentSetup" ValueChanged="OnSetupChanged" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                @foreach (var setup in Recommendations)
                {
                    <MudSelectItem Value="@setup">@setup.SetupName</MudSelectItem>
                }
                <MudSelectItem Value="@CustomSetup">自訂配置</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-4" />
        </MudItem>

        @* 狼人與平民 (數值調整) *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4 h-100">
                <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-4">狼人與平民陣營 (數量)</MudText>
                <MudGrid>
                    @foreach (var role in CurrentSetup.Roles.Where(r => r.Faction == "狼人" || r.Faction == "平民"))
                    {
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="role.Count" Label="@role.Name" Min="0" Max="10" Variant="Variant.Text" />
                        </MudItem>
                    }
                </MudGrid>
            </MudCard>
        </MudItem>

        @* 神職與第三方 (勾選調整) *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4 h-100">
                <MudText Typo="Typo.h6" Color="Color.Warning" Class="mb-4">神職與第三方陣營 (勾選)</MudText>
                <MudGrid>
                    @foreach (var role in CurrentSetup.Roles.Where(r => r.Faction == "神職" || r.Faction == "第三方"))
                    {
                        <MudItem xs="4">
                            <MudCheckBox T="bool" 
                                         Value="@(role.Count > 0)" 
                                         ValueChanged="@((bool isChecked) => OnRoleChecked(role, isChecked))" 
                                         Label="@role.Name" 
                                         Color="Color.Primary" />
                        </MudItem>
                    }
                </MudGrid>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@* 遊戲規則設定對話框 *@
<MudDialog @bind-IsVisible="isSettingsOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-3"/> 遊戲規則設定
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (CurrentSetup.Rule != null)
        {
            <MudRadioGroup @bind-Value="CurrentSetup.Rule.IsKillSide" T="bool" Class="mb-4">
                <MudText Typo="Typo.subtitle2" Class="mb-1">勝利條件</MudText>
                <MudRadio Value="@true" Color="Color.Primary">屠邊 (殺光神職 或 殺光平民)</MudRadio>
                <MudRadio Value="@false" Color="Color.Error">屠城 (殺光所有好人)</MudRadio>
            </MudRadioGroup>

            <MudSwitch @bind-Value="CurrentSetup.Rule.WitchCanSaveSelf" Color="Color.Success" Label="女巫首夜可自救" Class="mb-2" />
            <MudSwitch @bind-Value="CurrentSetup.Rule.DoubleDeadValid" Color="Color.Warning" Label="同守同救存活 (關閉則視為奶穿雙死)" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="() => isSettingsOpen = false">完成設定</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RoleSetup> Recommendations = new();
    private RoleSetup CurrentSetup = new();
    private RoleSetup CustomSetup = new() { SetupName = "自訂配置", Roles = GameConfigurator.GetBaseRoles() };

    // 動態計算總人數 (透過 Linq 的 Sum 快速加總所有角色的 Count)
    public int TotalPlayers => CurrentSetup?.Roles?.Sum(r => r.Count) ?? 0;

    // 設定對話框控制
    private bool isSettingsOpen = false;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override void OnInitialized()
    {
        Recommendations = GameConfigurator.GetRecommendations();
        // 預設載入第一個推薦版子
        if (Recommendations.Any())
        {
            CurrentSetup = Recommendations.First();
        }
        else
        {
            CurrentSetup = CustomSetup;
        }
    }

    // 當下拉選單切換版子時觸發
    private void OnSetupChanged(RoleSetup setup)
    {
        CurrentSetup = setup;
        StateHasChanged();
    }

    // 當神職的 CheckBox 被勾選或取消時觸發
    private void OnRoleChecked(RoleItem role, bool isChecked)
    {
        // 勾選就設定數量為 1，取消勾選就設為 0
        role.Count = isChecked ? 1 : 0;
        // 強制更新畫面，讓上方總人數重新計算
        StateHasChanged();
    }

    private void OpenSettings()
    {
        isSettingsOpen = true;
    }

    private void StartGame()
    {
        // TODO: 之後會在這裡實作將 CurrentSetup 存進 GameManager
        // 暫時先直接導航到遊戲控制台
        NavigationManager.NavigateTo("/game");
    }
}
