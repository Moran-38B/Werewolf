@page "/"
@using Werewolf.Models
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <MudGrid>
        @* 頂部標題與總人數 *@
        <MudItem xs="12" Class="d-flex justify-space-between align-center mb-2">
            <MudText Typo="Typo.h4" Color="Color.Primary">
                <b>建立遊戲</b> (目前 @TotalPlayers 人)
            </MudText>
        </MudItem>

        @* 推薦配置選單 *@
        <MudItem xs="12" md="7" lg="8">
            <MudSelect T="RoleSetup" Label="推薦版子 (快速套用)" Value="CurrentSetup" ValueChanged="OnSetupChanged" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" FullWidth="true">
                @foreach (var setup in Recommendations)
                {
                    <MudSelectItem Value="@setup">@setup.SetupName</MudSelectItem>
                }
                <MudSelectItem Value="@CustomSetup">自訂配置</MudSelectItem>
            </MudSelect>
        </MudItem>

        @* 右上角的操作按鈕 (加入 flex-column flex-sm-row 與 gap-3 解決手機重疊問題) *@
        <MudItem xs="12" md="5" lg="4" Class="d-flex flex-column flex-sm-row gap-3">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenSettings" Class="flex-grow-1" Style="height: 56px;">
                遊戲規則
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartGame" Class="flex-grow-1" Style="height: 56px;">
                產生座位
            </MudButton>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-2" />
        </MudItem>

        @* 左側區塊：狼人陣營與平民陣營 (分成兩張獨立的卡片) *@
        <MudItem xs="12" md="5">
            <MudGrid>
                @* 狼人陣營 *@
                <MudItem xs="12">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-2">狼人陣營</MudText>
                        <MudGrid>
                            @foreach (var role in CurrentSetup.Roles.Where(r => r.Faction == "狼人"))
                            {
                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="role.Count" Label="@role.Name" Min="0" Max="10" Variant="Variant.Text" />
                                </MudItem>
                            }
                        </MudGrid>
                    </MudCard>
                </MudItem>

                @* 平民陣營 *@
                <MudItem xs="12">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudText Typo="Typo.h6" Color="Color.Info" Class="mb-2">平民陣營</MudText>
                        <MudGrid>
                            @foreach (var role in CurrentSetup.Roles.Where(r => r.Faction == "平民"))
                            {
                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="role.Count" Label="@role.Name" Min="0" Max="10" Variant="Variant.Text" />
                                </MudItem>
                            }
                        </MudGrid>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudItem>

        @* 右側區塊：神職與第三方陣營 *@
        <MudItem xs="12" md="7">
            <MudCard Elevation="2" Class="pa-4 h-100">
                <MudText Typo="Typo.h6" Color="Color.Warning" Class="mb-4">神職與第三方陣營</MudText>
                <MudGrid>
                    @foreach (var role in CurrentSetup.Roles.Where(r => r.Faction == "神職" || r.Faction == "第三方"))
                    {
                        <MudItem xs="6" sm="4" lg="3">
                            <MudCheckBox T="bool" 
                                         Value="@(role.Count > 0)" 
                                         ValueChanged="@((bool isChecked) => OnRoleChecked(role, isChecked))" 
                                         Label="@role.Name" 
                                         Color="Color.Primary" />
                        </MudItem>
                    }
                </MudGrid>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@* 遊戲規則設定對話框 *@
<MudDialog @bind-IsVisible="isSettingsOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-3"/> 遊戲規則設定
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudRadioGroup @bind-Value="GlobalRule.IsKillSide" T="bool" Class="mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-1">勝利條件</MudText>
            <MudRadio Value="@true" Color="Color.Primary">屠邊 (殺光神職 或 殺光平民)</MudRadio>
            <MudRadio Value="@false" Color="Color.Error">屠城 (殺光所有好人)</MudRadio>
        </MudRadioGroup>

        <MudSwitch @bind-Value="GlobalRule.WitchCanSaveSelf" Color="Color.Success" Label="女巫首夜可自救" Class="mb-2" />
        <MudSwitch @bind-Value="GlobalRule.DoubleDeadValid" Color="Color.Warning" Label="同守同救存活 (關閉則視為奶穿雙死)" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="() => isSettingsOpen = false">完成設定</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RoleSetup> Recommendations = new();
    private RoleSetup CurrentSetup = new();
    private RoleSetup CustomSetup = new() { SetupName = "自訂配置", Roles = GameConfigurator.GetBaseRoles() };

    private GameRule GlobalRule = new(); 

    public int TotalPlayers => CurrentSetup?.Roles?.Sum(r => r.Count) ?? 0;

    private bool isSettingsOpen = false;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override void OnInitialized()
    {
        Recommendations = GameConfigurator.GetRecommendations();
        if (Recommendations.Any())
        {
            CurrentSetup = Recommendations.First();
        }
        else
        {
            CurrentSetup = CustomSetup;
        }
    }

    private void OnSetupChanged(RoleSetup setup)
    {
        CurrentSetup = setup;
        StateHasChanged();
    }

    private void OnRoleChecked(RoleItem role, bool isChecked)
    {
        role.Count = isChecked ? 1 : 0;
        StateHasChanged();
    }

    private void OpenSettings()
    {
        isSettingsOpen = true;
    }

    private void StartGame()
    {
        NavigationManager.NavigateTo("/game");
    }
}
