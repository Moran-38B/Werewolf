@page "/"
@using Werewolf.Models
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <MudGrid>
        @* 頂部標題與總人數 *@
        <MudItem xs="12" Class="mb-2">
            <MudText Typo="Typo.h4" Color="Color.Primary">
                <b>建立遊戲</b> (目前 @TotalPlayers 人)
            </MudText>
        </MudItem>

        @* 推薦配置與操作按鈕 (改用 MudGrid 精準控制寬度與對齊) *@
        <MudItem xs="12">
            <MudGrid Spacing="3">
                
                @* 左側：推薦配置下拉選單 (佔據大比例空間 md="8" lg="9"，填滿空白) *@
                <MudItem xs="12" md="8" lg="9">
                    <MudSelect T="RoleSetup" Label="推薦版子 (快速套用)" Value="CurrentSetup" ValueChanged="OnSetupChanged" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" FullWidth="true" Class="mb-0">
                        @foreach (var setup in Recommendations)
                        {
                            <MudSelectItem Value="@setup">@setup.SetupName</MudSelectItem>
                        }
                        <MudSelectItem Value="@CustomSetup">自訂配置</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* 右側：操作按鈕 (加入 mt-md-2 將按鈕微幅向下推，完美切齊左側的輸入外框) *@
                <MudItem xs="12" md="4" lg="3" Class="d-flex gap-3 mt-md-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenSettings" Style="height: 56px;" Class="flex-grow-1">
                        遊戲規則
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartGame" Style="height: 56px;" Class="flex-grow-1">
                        產生座位
                    </MudButton>
                </MudItem>
                
            </MudGrid>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-2" />
        </MudItem>

        @* 左右分區：左邊 (平民+狼人)，右邊 (神職+第三方) *@
        
        @* ===== 左半區塊：平民與狼人 ===== *@
        <MudItem xs="12" md="6">
            <div class="d-flex flex-column gap-4 h-100">
                @* 1. 平民陣營區塊 *@
                <MudCard Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Color="Color.Info" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2 mb-n1"/> 平民陣營
                    </MudText>
                    <MudGrid>
                        @foreach (var role in CurrentSetup.Roles.Where(r => r.Faction == "平民"))
                        {
                            <MudItem xs="6" sm="4">
                                <MudNumericField @bind-Value="role.Count" Label="@role.Name" Min="0" Max="10" 
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" InputMode="@(InputMode.none)" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudCard>

                @* 2. 狼人陣營區塊 *@
                <MudCard Elevation="2" Class="pa-4 flex-grow-1">
                    <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-2 mb-n1"/> 狼人陣營
                    </MudText>
                    <MudGrid>
                        @foreach (var role in CurrentSetup.Roles.Where(r => r.Faction == "狼人"))
                        {
                            <MudItem xs="6" sm="4">
                                <MudNumericField @bind-Value="role.Count" Label="@role.Name" Min="0" Max="10" 
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" InputMode="@(InputMode.none)" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudCard>
            </div>
        </MudItem>

        @* ===== 右半區塊：神職與第三方陣營 ===== *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4 h-100">
                <MudText Typo="Typo.h6" Color="Color.Warning" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Stars" Size="Size.Small" Class="mr-2 mb-n1"/> 神職與第三方 (勾選)
                </MudText>
                <MudGrid>
                    @foreach (var role in CurrentSetup.Roles.Where(r => r.Faction == "神職" || r.Faction == "第三方"))
                    {
                        <MudItem xs="6" sm="4">
                            <MudCheckBox T="bool" 
                                         Value="@(role.Count > 0)" 
                                         ValueChanged="@((bool isChecked) => OnRoleChecked(role, isChecked))" 
                                         Label="@role.Name" 
                                         Color="Color.Primary" />
                        </MudItem>
                    }
                </MudGrid>
            </MudCard>
        </MudItem>

    </MudGrid>
</MudContainer>

@* 遊戲規則設定對話框 *@
<MudDialog @bind-Visible="isSettingsOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-3"/> 遊戲規則設定
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudRadioGroup @bind-Value="GlobalRule.IsKillSide" T="bool" Class="mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-1">勝利條件</MudText>
            <MudRadio Value="@true" Color="Color.Primary">屠邊 (殺光神職 或 殺光平民)</MudRadio>
            <MudRadio Value="@false" Color="Color.Error">屠城 (殺光所有好人)</MudRadio>
        </MudRadioGroup>

        <MudSwitch @bind-Value="GlobalRule.WitchCanSaveSelf" Color="Color.Success" Label="女巫首夜可自救" Class="mb-2" />
        <MudSwitch @bind-Value="GlobalRule.DoubleDeadValid" Color="Color.Warning" Label="同守同救存活 (關閉則視為奶穿雙死)" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="() => isSettingsOpen = false">完成設定</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RoleSetup> Recommendations = new();
    private RoleSetup CurrentSetup = new();
    private RoleSetup CustomSetup = new() { SetupName = "自訂配置", Roles = GameConfigurator.GetBaseRoles() };
    private GameRule GlobalRule = new(); // 獨立的遊戲規則設定

    // 動態計算總人數
    public int TotalPlayers => CurrentSetup?.Roles?.Sum(r => r.Count) ?? 0;

    private bool isSettingsOpen = false;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override void OnInitialized()
    {
        Recommendations = GameConfigurator.GetRecommendations();
        if (Recommendations.Any())
        {
            CurrentSetup = Recommendations.First();
        }
        else
        {
            CurrentSetup = CustomSetup;
        }
    }

    private void OnSetupChanged(RoleSetup setup)
    {
        CurrentSetup = setup;
        StateHasChanged();
    }

    private void OnRoleChecked(RoleItem role, bool isChecked)
    {
        role.Count = isChecked ? 1 : 0;
        StateHasChanged();
    }

    private void OpenSettings()
    {
        isSettingsOpen = true;
    }

    private void StartGame()
    {
        // TODO: 建立 GameManager 後，將設定寫入並導航
        NavigationManager.NavigateTo("/game");
    }
}
