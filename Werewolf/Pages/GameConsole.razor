@page "/game"
@using Werewolf.Models
@using Werewolf.Services
@inject GameManager GameManager
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    @if (CurrentPhase == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        @* 頂部資訊列 *@
        <MudItem xs="12" Class="mb-4 d-flex justify-space-between align-center">
            <MudText Typo="Typo.h5" Color="Color.Primary">
                <b>第一晚：身份派發與確認 - @CurrentPhase.RoleName</b>
            </MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="OpenEncyclopedia">
                    角色百科
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.ExitToApp" OnClick="EndGame">
                    重新設定
                </MudButton>
            </div>
        </MudItem>

        <MudGrid Spacing="4">
            @* 左側：職業順序與腳本 *@
            <MudItem xs="12" md="3">
                <MudCard Elevation="3" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="mr-2 mb-n1"/> 職業順序
                    </MudText>
                    
                    <MudTimeline TimelinePosition="TimelinePosition.Start">
                        @for (int i = 0; i < NightPhases.Count; i++)
                        {
                            var phase = NightPhases[i];
                            var isActive = i == currentPhaseIndex;
                            var isPast = i < currentPhaseIndex;

                            <MudTimelineItem Color="@(isActive ? Color.Primary : (isPast ? Color.Success : Color.Default))" Size="Size.Small">
                                <MudText Typo="@(isActive ? Typo.subtitle1 : Typo.body2)" Class="@(isActive ? "font-weight-bold mud-primary-text" : "mud-text-secondary")">
                                    @phase.RoleName
                                </MudText>
                            </MudTimelineItem>
                        }
                    </MudTimeline>

                    <MudDivider Class="my-4" />
                    
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">腳本提示</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.VolumeUp" Color="Color.Primary" Size="Size.Small" title="播放語音" />
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space: pre-line;">
                        @CurrentPhase.ScriptText
                    </MudText>
                </MudCard>
            </MudItem>

            @* 右側：玩家座位表與互動區 *@
            <MudItem xs="12" md="9">
                <MudCard Elevation="3" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.EventSeat" Class="mr-2 mb-n1"/> 玩家座位表 (可點擊切換)
                    </MudText>

                    @* 座位網格 *@
                    <MudGrid Spacing="2" Class="mb-6">
                        @foreach (var player in GameManager.Players)
                        {
                            var isSelected = player.Role == CurrentPhase.Role || (CurrentPhase.Role == Role.Werewolf && IsSpecialWolf(player.Role));
                            var isTargeted = player.SeatNumber == currentTargetSeat;

                            <MudItem xs="4" sm="3" md="2">
                                <MudCard Elevation="@(isSelected || isTargeted ? 4 : 1)" 
                                         Class="@($"pa-3 text-center cursor-pointer {(isSelected ? "bg-primary text-white" : isTargeted ? "bg-error text-white" : "mud-theme-dark")}")"
                                         Style="@($"border-radius: 12px; border: {(isTargeted ? "2px solid red" : "none")}; transition: 0.2s;")"
                                         @onclick="@(() => OnSeatClicked(player))">
                                    
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">@player.SeatNumber</MudText>
                                    
                                    @if (isSelected)
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block mt-1">@player.RoleName</MudText>
                                    }
                                    else if (isTargeted)
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block mt-1">@CurrentPhase.TargetLabel</MudText>
                                    }
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    @* 下方動態選項區 (依據職業切換) *@
                    
                    @* 1. 盜賊專屬：底牌選擇 *@
                    @if (CurrentPhase.Role == Role.Thief)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2 font-weight-bold">盜賊排底選項：</MudText>
                        <div class="d-flex gap-4">
                            @for (int i = 0; i < 2; i++)
                            {
                                var index = i;
                                <MudSelect T="Role" Label="@($"底牌 {index + 1}")" Value="@GameManager.BottomCards[index]" ValueChanged="@((Role r) => GameManager.BottomCards[index] = r)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@Role.Unknown">未知身份</MudSelectItem>
                                    @foreach (var r in GameManager.CurrentSetup.Roles.Where(x => x.Count > 0))
                                    {
                                        <MudSelectItem Value="@r.Role">@r.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </div>
                    }

                    @* 2. 狼人專屬：特殊狼指派 *@
                    @if (CurrentPhase.Role == Role.Werewolf && HasSpecialWolvesInSetup())
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2 mt-2 font-weight-bold">設定特殊狼 (請先點擊上方座位，再點擊下方身分)：</MudText>
                        <div class="d-flex gap-3 flex-wrap">
                            @foreach (var sw in GetSpecialWolvesInSetup())
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" 
                                           OnClick="@(() => ConvertSelectedWolfToSpecial(sw.Role, sw.Name))">
                                    @sw.Name
                                </MudButton>
                            }
                        </div>
                    }

                    @* 3. 需要指定目標的職業 (擊殺/查驗/使用技能) *@
                    @if (!string.IsNullOrEmpty(CurrentPhase.TargetLabel))
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2 mt-4 font-weight-bold text-error">
                            @CurrentPhase.TargetLabel (請點選目標座位)：
                            @if (currentTargetSeat > 0)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-2">@currentTargetSeat 號</MudChip>
                            }
                        </MudText>
                    }
                    
                    <div class="d-flex justify-end mt-6">
                        @if (CurrentPhase.Role == Role.Thief)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="NextStep" Style="height: 56px;">
                                <MudIcon Icon="@Icons.Material.Filled.DoneAll" Class="mr-2"/> 雙擊確認 (Next Step)
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="NextStep" Style="height: 56px; min-width: 150px;">
                                Next Step
                            </MudButton>
                        }
                    </div>

                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@* 百科對話框保留 *@
<MudDialog @bind-Visible="isEncyclopediaOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-2 mb-n1"/> 角色技能百科</MudText>
    </TitleContent>
    <DialogContent>
        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            @foreach (var role in GameDictionary.GetAllRoles())
            {
                <MudExpansionPanel Text="@role.Name">
                    <MudText Typo="Typo.body2" Class="mb-2"><b>技能：</b>@role.Description</MudText>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </DialogContent>
</MudDialog>

@code {
    private bool isEncyclopediaOpen = false;
    
    // 狀態機核心變數
    private List<NightPhase> NightPhases = new();
    private int currentPhaseIndex = 0;
    private NightPhase? CurrentPhase => NightPhases.Count > 0 && currentPhaseIndex < NightPhases.Count ? NightPhases[currentPhaseIndex] : null;

    // 行動目標暫存 (擊殺、查驗等)
    private int currentTargetSeat = -1;

    protected override void OnInitialized()
    {
        if (GameManager.CurrentSetup.Roles.Sum(r => r.Count) == 0)
        {
            NavigationManager.NavigateTo("");
            return;
        }

        if (GameManager.Players.Count == 0)
        {
            GameManager.InitializeGame();
        }

        BuildNightPhases();
    }

    // 依據玩家板子，動態建立第一晚的睜眼腳本步驟
    private void BuildNightPhases()
    {
        NightPhases.Clear();
        var rolesInPlay = GameManager.CurrentSetup.Roles.Where(r => r.Count > 0).ToList();

        if (rolesInPlay.Any(r => r.Role == Role.Thief))
        {
            NightPhases.Add(new NightPhase { Role = Role.Thief, RoleName = "盜賊", ScriptText = "盜賊請睜眼。\n請確認你要交換的底牌。", TargetLabel = "" });
        }
        
        if (rolesInPlay.Any(r => r.Faction == "狼人"))
        {
            NightPhases.Add(new NightPhase { Role = Role.Werewolf, RoleName = "狼人", ScriptText = "狼人請睜眼。\n請確認彼此身份，狼王/白狼王請示意。\n狼人請決定擊殺對象。", TargetLabel = "擊殺對象" });
        }

        if (rolesInPlay.Any(r => r.Role == Role.Gargoyle))
        {
            NightPhases.Add(new NightPhase { Role = Role.Gargoyle, RoleName = "石像鬼", ScriptText = "石像鬼請睜眼。\n請選擇你要查驗的對象。", TargetLabel = "查驗對象" });
        }
    }

    // 座位點擊邏輯
    private void OnSeatClicked(Player player)
    {
        if (CurrentPhase == null) return;

        if (!string.IsNullOrEmpty(CurrentPhase.TargetLabel) && player.Role != CurrentPhase.Role && !IsSpecialWolf(player.Role))
        {
            currentTargetSeat = (currentTargetSeat == player.SeatNumber) ? -1 : player.SeatNumber;
            return;
        }

        if (player.Role == CurrentPhase.Role || IsSpecialWolf(player.Role))
        {
            player.Role = Role.Unknown;
            player.RoleName = "未知身份";
            player.Faction = "未知";
        }
        else if (player.Role == Role.Unknown)
        {
            player.Role = CurrentPhase.Role;
            var roleInfo = GameManager.CurrentSetup.Roles.FirstOrDefault(r => r.Role == CurrentPhase.Role);
            player.RoleName = roleInfo?.Name ?? "未知";
            player.Faction = roleInfo?.Faction ?? "未知";
            
            if (currentTargetSeat == player.SeatNumber) currentTargetSeat = -1;
        }
    }

    private void ConvertSelectedWolfToSpecial(Role specialRole, string specialName)
    {
        var lastWolf = GameManager.Players.LastOrDefault(p => p.Role == Role.Werewolf);
        if (lastWolf != null)
        {
            lastWolf.Role = specialRole;
            lastWolf.RoleName = specialName;
            lastWolf.Faction = "狼人";
        }
    }

    private bool HasSpecialWolvesInSetup() => GameManager.CurrentSetup.Roles.Any(r => IsSpecialWolf(r.Role) && r.Count > 0);
    private List<RoleItem> GetSpecialWolvesInSetup() => GameManager.CurrentSetup.Roles.Where(r => IsSpecialWolf(r.Role) && r.Count > 0).ToList();
    private bool IsSpecialWolf(Role role) => role == Role.WolfKing || role == Role.WhiteWolfKing || role == Role.WolfBeauty || role == Role.GhostRider || role == Role.BloodMoonApostle || role == Role.HiddenWolf;

    private void NextStep()
    {
        currentTargetSeat = -1;

        if (currentPhaseIndex < NightPhases.Count - 1)
        {
            currentPhaseIndex++;
        }
        else
        {
            NavigationManager.NavigateTo("/day"); 
        }
    }

    private void OpenEncyclopedia() => isEncyclopediaOpen = true;
    private void EndGame()
    {
        GameManager.Players.Clear();
        NavigationManager.NavigateTo("");
    }

    public class NightPhase
    {
        public Role Role { get; set; }
        public string RoleName { get; set; } = "";
        public string ScriptText { get; set; } = "";
        public string TargetLabel { get; set; } = ""; 
    }
}
