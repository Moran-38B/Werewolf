@page "/game"
@using Werewolf.Models
@using Werewolf.Services
@inject GameManager GameManager
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    @* 頂部資訊列 *@
    <MudItem xs="12" Class="mb-4 d-flex justify-space-between align-center">
        <MudText Typo="Typo.h4" Color="Color.Primary">
            <b>法官登記板</b> (@GameManager.Players.Count 人局)
        </MudText>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="OpenEncyclopedia">
                角色百科
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.ExitToApp" OnClick="EndGame">
                重新設定
            </MudButton>
        </div>
    </MudItem>
		
		@* 盜賊專屬：底牌登記區 *@
    @if (GameManager.HasThief)
    {
        <MudItem xs="12" Class="mb-4">
            <MudCard Elevation="2" Class="pa-4" Style="background-color: var(--mud-palette-background-grey);">
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-2 mb-n1"/> 盜賊底牌區
                </MudText>
                <MudGrid>
                    @for (int i = 0; i < 2; i++)
                    {
                        var index = i; // 必須用區域變數捕捉，否則 Blazor 綁定會出錯
                        <MudItem xs="6" sm="4" md="3">
                        		<MudSelect T="Role" Label="@($"底牌 {index + 1}")" Value="@GameManager.BottomCards[index]" ValueChanged="@((Role r) => GameManager.BottomCards[index] = r)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="bg-white">
            										<MudSelectItem Value="@Role.Unknown">未知身分</MudSelectItem>
            												@foreach (var role in GameManager.CurrentSetup.Roles.Where(r => r.Count > 0))
            												{
                												<MudSelectItem Value="@role.Role">@role.Name</MudSelectItem>
            												}
        												</MudSelect>

                    }
                </MudGrid>
            </MudCard>
        </MudItem>
    }

    @* 座位網格 (使用 MudSelect 讓法官手動選身分) *@
    <MudGrid Spacing="3">
        @foreach (var player in GameManager.Players)
        {
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudCard Elevation="3" Class="pa-4" Style="border-radius: 12px; height: 100%;">
                    
                    @* 座位號碼與警徽標示 *@
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                            <b>@player.SeatNumber</b>
                        </MudAvatar>
                        
                        @if (player.HasBadge)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.LocalPolice" Color="Color.Warning" />
                        }
                    </div>
                    
                    @* 讓法官選擇該座位的真實身分 *@
                    <MudSelect T="Role" Label="設定身分" Value="@player.Role" ValueChanged="@((Role r) => OnRoleAssigned(player, r))" Variant="Variant.Text" Margin="Margin.Dense" Class="mt-2">
            						<MudSelectItem Value="@Role.Unknown">未知身分</MudSelectItem>
            								@foreach (var role in GameManager.CurrentSetup.Roles.Where(r => r.Count > 0))
            								{
                								<MudSelectItem Value="@role.Role">@role.Name</MudSelectItem>
       					     				}
					  	      </MudSelect>

                    @* 顯示該角色的所屬陣營 *@
                    @if (player.RoleName != "未知身分")
                    {
                        <MudText Typo="Typo.caption" Color="@GetFactionColor(player.Faction)" Class="d-block mt-2 text-center">
                            @player.Faction
                        </MudText>
                    }

                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@* 角色百科對話框 *@
<MudDialog @bind-Visible="isEncyclopediaOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-2 mb-n1"/> 角色技能百科
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            @foreach (var role in GameDictionary.GetAllRoles())
            {
                <MudExpansionPanel Text="@role.Name" 
                                   Style="@(role.Faction == "好人" ? "color: var(--mud-palette-info);" : role.Faction == "狼人" ? "color: var(--mud-palette-error);" : "color: var(--mud-palette-success);")">
                    <MudText Typo="Typo.body2" Class="mb-2"><b>技能：</b>@role.Description</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Success" Class="mb-1"><b>優點：</b>@role.Advantage</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Error"><b>缺點：</b>@role.Disadvantage</MudText>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </DialogContent>
</MudDialog>

@code {

    // 控制角色百科視窗
    private bool isEncyclopediaOpen = false;

    private void OpenEncyclopedia()
    {
        isEncyclopediaOpen = true;
    }

    protected override void OnInitialized()
    {
        if (GameManager.CurrentSetup.Roles.Sum(r => r.Count) == 0)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        if (GameManager.Players.Count == 0)
        {
            GameManager.InitializeGame();
        }
    }

    // 當法官在下拉選單選擇身分時，自動綁定對應的陣營
    private void OnRoleAssigned(Player player, Role selectedRole)
    {
        player.Role = selectedRole;
        
        var setupRole = GameManager.CurrentSetup.Roles.FirstOrDefault(r => r.Role == selectedRole);
        if (setupRole != null)
        {
            // 同步更新中文名稱與陣營給 UI 顯示
            player.RoleName = setupRole.Name;
            player.Faction = setupRole.Faction;
        }
        else
        {
            player.RoleName = "未知身分";
            player.Faction = "未知";
        }
    }



    private Color GetFactionColor(string faction)
    {
        return faction switch
        {
            "平民" => Color.Info,
            "狼人" => Color.Error,
            "神職" => Color.Warning,
            "第三方" => Color.Success,
            _ => Color.Default
        };
    }

    private void EndGame()
    {
        GameManager.Players.Clear();
        NavigationManager.NavigateTo("/");
    }
}
