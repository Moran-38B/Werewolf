@page "/seatmap"
@using Werewolf.Models

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <MudToolBar Class="mb-4 px-0">
        <MudText Typo="Typo.h5"><b>法官控制台</b> (目前 @Players.Count 人局)</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Shuffle">
            隨機發牌
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2">
            進入天黑
        </MudButton>
    </MudToolBar>

    @* Spacing="2" 讓卡片之間的間距適中 *@
    <MudGrid Spacing="2">
        @foreach (var player in Players)
        {
            @* xs="4" (手機一列3個), sm="3" (直立平板一列4個), md="2" (橫向iPad一列6個) *@
            <MudItem xs="4" sm="3" md="2">
                <MudCard Elevation="2" Class="@GetCardClass(player)" Style="border-radius: 12px; cursor: pointer;"
                         @onclick="() => OnSeatClicked(player)">

                    <MudCardHeader Class="pa-2 pb-0 d-flex justify-space-between align-center">
                        @* 座位號碼 *@
                        <MudAvatar Color="@(player.IsAlive? Color.Primary: Color.Default)" Size="Size.Small" Variant="Variant.Filled">
                            <b>@player.SeatNumber</b>
                        </MudAvatar>

                        @* 警徽標記 *@
                        @if (player.HasBadge)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.LocalPolice" Color="Color.Warning" Size="Size.Small" />
                        }
                    </MudCardHeader>

                    <MudCardContent Class="pa-2 text-center">
                        @* 顯示身分 (如果是 Unknown 就顯示問號) *@
                        <MudText Typo="Typo.h6" Class="mt-1">
                            <b>@(player.Role == Role.Unknown ? "?" : GetRoleName(player.Role))</b>
                        </MudText>

                        @* 狀態提示文字 (例如死亡原因) *@
                        <MudText Typo="Typo.caption" Color="@(player.IsAlive? Color.Success: Color.Error)">
                            @(player.IsAlive ? "存活" : player.DeadReason)
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    // 假資料：模擬 18 人局的玩家狀態，方便我們預覽排版
    private List<Player> Players = new();

    protected override void OnInitialized()
    {
        // 產生 18 個座位作為佈局預覽
        for (int i = 1; i <= 18; i++)
        {
            Players.Add(new Player
            {
                SeatNumber = i,
                Role = Role.Unknown,
                IsAlive = true
            });
        }

        // 隨機弄幾個假狀態來預覽視覺效果
        Players[0].Role = Role.Witch;
        Players[0].HasBadge = true; // 1號女巫拿警徽

        Players[4].IsAlive = false;
        Players[4].Role = Role.Werewolf;
        Players[4].DeadReason = "吃毒"; // 5號狼人被毒死
    }

    // 動態計算卡片的 CSS Class
    private string GetCardClass(Player player)
    {
        var baseClass = "pa-1 transition-all";
        // 如果玩家死亡，讓整張卡片變暗，並加上紅色邊框
        if (!player.IsAlive)
            return $"{baseClass} mud-theme-dark opacity-50 border-solid border-2 mud-border-error";

        return $"{baseClass} mud-theme-dark";
    }

    // 將 Role 列舉轉回中文名稱的方法 (之後可以移到共用工具類別)
    private string GetRoleName(Role role)
    {
        return role switch
        {
            Role.Witch => "女巫",
            Role.Werewolf => "狼人",
            Role.Seer => "預言家",
            _ => role.ToString()
        };
    }

    // 點擊座位的事件
    private void OnSeatClicked(Player player)
    {
        // TODO: 點擊後彈出選單，讓法官設定身分或標記死亡
        Console.WriteLine($"點擊了 {player.SeatNumber} 號座位");
    }
}